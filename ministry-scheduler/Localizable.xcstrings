    "You have %@ of margin. You can do less on an upcoming day if you need to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %@ Spielraum. Bei Bedarf kannst du an einem kommenden Tag weniger machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes %@ de margen. Si lo necesitas, puedes hacer menos algún día próximo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as %@ de marge. Si besoin, tu peux en faire moins un des prochains jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai %@ di margine. Se serve, puoi fare meno in uno dei prossimi giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の余裕があります。必要なら今後の日を少し減らせます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har %@ å gå på. Du kan gjøre mindre en kommende dag om du trenger det."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz %@ zapasu. W razie potrzeby możesz zrobić mniej w któryś z kolejnych dni."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem %@ de margem. Se precisar, pode fazer menos em um dos próximos dias."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你有%@的余量。如有需要，可以在接下来的某天少做一些。"
          }
        }
      }
    },
