    "%@ does not fit in your planned days. Plan it on a free day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ passt nicht in deine geplanten Tage. Plane sie an einem freien Tag ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no cabe en tus días planificados. Planifícalo en un día libre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne rentre pas dans tes jours prévus. Prévois-le un jour libre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non rientra nei giorni pianificati. Pianificalo in un giorno libero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は予定日に収まりません。空いている日に予定を入れてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ får ikke plass i de planlagte dagene. Planlegg det på en ledig dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie mieści się w zaplanowanych dniach. Zaplanuj to na wolny dzień."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não cabe nos dias planejados. Planeje em um dia livre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@无法安排在已计划的日子里。请安排在空闲的一天。"
          }
        }
      }
    },
