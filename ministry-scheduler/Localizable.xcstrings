    "To catch up, add the time shown in orange to the marked days. Next: %@, +%@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um aufzuholen, füge den markierten Tagen die orange angezeigte Zeit hinzu. Nächster: %1$@, +%2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To catch up, add the time shown in orange to the marked days. Next: %1$@, +%2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para compensar, añade el tiempo en naranja a los días marcados. Próximo: %1$@, +%2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour rattraper, ajoute le temps affiché en orange aux jours marqués. Prochain : %1$@, +%2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per recuperare, aggiungi il tempo indicato in arancione ai giorni segnati. Prossimo: %1$@, +%2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り戻すには、印の付いた日にオレンジ色の時間を追加してください。次: %1$@、+%2$@。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å ta det igjen, legg til tiden i oransje på de merkede dagene. Neste: %1$@, +%2$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby nadrobić, dodaj czas zaznaczony na pomarańczowo do oznaczonych dni. Następny: %1$@, +%2$@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para compensar, adicione o tempo em laranja aos dias marcados. Próximo: %1$@, +%2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要补回，请在标记的日子加上橙色显示的时间。下一个：%1$@，+%2$@。"
          }
        }
      }
    },
